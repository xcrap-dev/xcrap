{
  "name": "xcrap",
  "version": "3.0.0",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/*",
    "!/**/__tests__"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "ts-node ./src/index.ts",
    "format": "prettier --write \"src/**/*.ts\" \"__tests__/**/*.ts\"",
    "test": "jest"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "web scraping",
    "xcrap",
    "scrapy"
  ],
  "author": "Marcuth",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.2",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^30.2.0",
    "prettier": "^3.8.1",
    "prettier-plugin-sort-imports": "^1.8.11",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@xcrap/core": "^0.2.3",
    "@xcrap/extractor": "^0.3.2",
    "@xcrap/transformer": "^1.0.0",
    "@xcrap/xml-extractor": "^0.1.0",
    "zod": "^4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Xcrap-Cloud/xcrap.git"
  },
  "exports": {
    ".": "./dist/index.js",
    "./core": "./dist/core/index.js",
    "./extractor": "./dist/extractor/index.js",
    "./transformer": "./dist/transformer/index.js"
  },
  "typesVersions": {
    "*": {
      "core": [
        "dist/core/index.d.ts"
      ],
      "extractor": [
        "dist/extractor/index.d.ts"
      ],
      "transformer": [
        "dist/transformer/index.d.ts"
      ]
    }
  }
}
